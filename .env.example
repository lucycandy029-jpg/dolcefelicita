# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
PORT="3000"

# ==============================================================================
# BANCO DE DADOS: PostgreSQL 17 (Container Docker 'postgres-servidor' no Proxmox)
# ==============================================================================
# URL completa de conexão para o banco exclusivo 'dolce_felicita'
# Exemplo de rede local/VPN: postgresql://dolce_user:SENHA_AQUI@IP_DO_APPS_01:5432/dolce_felicita?sslmode=disable
DATABASE_URL="postgresql://usuario:senha@host:5432/dolce_felicita"

# Parâmetros avulsos caso prefira configurar por variável individual:
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="dolce_felicita"
PGUSER="dolce_felicita_app"
PGPASSWORD="sua_senha_segura"

# ==============================================================================
# SEGURANÇA E SESSÃO
# ==============================================================================
SESSION_SECRET="uma_chave_secreta_longa_e_aleatoria_para_assinatura_de_cookies"
JWT_SECRET="uma_chave_secreta_para_tokens_caso_utilize_jwt"
NODE_ENV="development"

